
# Tooling caches that should never be tracked. The whole .claude/ tree
# is local-only EXCEPT the committed, shared branch-first guard (the
# settings.json hook + its script). settings.local.json, worktrees/,
# projects/, and everything else stay ignored.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Procedures that used to live in CLAUDE.md, moved out so they load on
# invocation instead of costing context every session. CLAUDE.md points at
# them, so they are checked in for the same reason it is.
!.claude/skills/
# ...but not netsec-design: a 33 MB local design bundle (fonts, a .pptx,
# screenshots, scraps) that belongs on disk rather than in git history.
# Re-excluded after the un-ignore above, since git cannot re-include a path
# whose parent directory is still excluded.
.claude/skills/netsec-design/
scripts/__pycache__/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# macOS/iCloud "Foo 2.ext" duplicate files that get spawned in
# the working tree by some sync tools.
* 2.*
* 3.*

# Pagefind search index — built at deploy time by the Pages workflow
# (.github/workflows/pages-deploy.yml), not committed to main. See
# docs/architecture.md ("Site-wide search") for the rationale. Two
# parallel PRs that both touched HTML used to conflict on this
# directory's content-hashed shard filenames; deferring the build to
# the deploy step eliminates the conflict source. To rebuild the
# index locally for testing, run ./scripts/build-search.sh — the
# result is gitignored and won't be staged.
pagefind/

# Per-member Open Graph cards, rendered at deploy time by the same workflow
# (#1716). 84 PNGs plus their manifest, rewritten by the weekly bios and COST
# syncs, each regeneration a new blob kept in the history for good. Nobody
# hand-edits them and nothing but a crawler reads them. Build them locally with
# scripts/build-og-cards.py; the result is gitignored and won't be staged.
assets/og/people/*.png
assets/og/people/_manifest.json

# The 252 member profile pages, built by the same deploy (#1716). Generated
# from data/bios.json + data/orcid-works.json + the people.* shells, they were
# rewritten by both weekly syncs and by every change to a shell. Build them
# locally with scripts/build-profile-pages.py; the result is gitignored.
/people/

# Scratch / report directory used by the QA scripts (a11y report,
# Lighthouse JSON, link-check output). Always regeneratable; never
# tracked.
tmp/

/ogcards-*/

# npm (directory interaction tests)
node_modules/
